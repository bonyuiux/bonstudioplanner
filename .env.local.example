# ─── Supabase ─────────────────────────────────────────────────────────────────
# Find these in your Supabase dashboard:
#   Project Settings → API → Project URL  (copy the full URL)
#   Project Settings → API → Project API keys → anon / public

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Instructions ─────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local  (it is gitignored)
# 2. Create a Supabase project at https://supabase.com
# 3. In the SQL editor, run the full contents of supabase/schema.sql
# 4. Paste your Project URL and anon key above
# 5. In Authentication → Providers, make sure Email is enabled
# 6. In Authentication → Users, create your single user account
#    (or use the "Send magic link" / "Create user" button in the dashboard)
# 7. Run: npm run dev
